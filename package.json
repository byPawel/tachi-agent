{
  "name": "tachi-agent",
  "version": "0.3.0",
  "description": "Local-first orchestration agent — a pluggable ReAct hub that fuses dokoro memory + tachibot multi-model council over MCP. Default brain runs 100% local (Qwen2.5/Ollama).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tachi-agent": "dist/cli.js",
    "tachi-agent-mcp": "dist/frontends/mcp-server.js",
    "tachi-agent-gateway": "dist/frontends/gateway.js",
    "tachi-agent-daemon": "dist/daemon/index.js",
    "tachi-agent-telegram": "dist/frontends/telegram.js",
    "tachi-agent-slack": "dist/frontends/slack.js",
    "tachi-agent-repl": "dist/frontends/repl.js",
    "tachi-agent-swarm": "dist/frontends/swarm.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byPawel/tachi-agent.git"
  },
  "homepage": "https://bypawel.github.io/tachi-agent/",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/index.ts",
    "agent": "tsc -p tsconfig.build.json && node --env-file=.env dist/cli.js",
    "repl": "tsc -p tsconfig.build.json && node --env-file=.env dist/frontends/repl.js",
    "telegram": "tsc -p tsconfig.build.json && node --env-file=.env dist/frontends/telegram.js",
    "slack": "tsc -p tsconfig.build.json && node --env-file=.env dist/frontends/slack.js",
    "gateway": "tsc -p tsconfig.build.json && node --env-file=.env dist/frontends/gateway.js",
    "daemon": "tsc -p tsconfig.build.json && node --env-file=.env dist/daemon/index.js",
    "swarm": "tsc -p tsconfig.build.json && node --env-file=.env dist/frontends/swarm.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
