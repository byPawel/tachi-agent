# Local brain (Ollama) — runs on-device, zero-cost, offline
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5
OLLAMA_NUM_CTX=8192
# MCP servers the agent consumes (space-separated command+args). Leave blank to skip.
# dokoro = persistent memory ; tachibot = multi-model council + search
TACHIBOT_CMD=npx -y tachibot-mcp
DOKORO_CMD=npx -y @devlog-mcp/core
