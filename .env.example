# Local brain (Ollama) — runs on-device, zero-cost, offline.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# A TOOL-CALLING model you've pulled (`ollama pull <model>` first): qwen3:8b, qwen2.5, llama3.2, qwen3:30b…
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=8192

# MCP servers the agent consumes (space-separated command+args). Leave blank to skip.
# tachibot = multi-model council + search ; dokoro = persistent memory.
TACHIBOT_CMD=npx -y tachibot-mcp
# dokoro: point at your LOCAL build (package is `dokoro`, not @devlog-mcp/core):
DOKORO_CMD=node /absolute/path/to/dokoro/bin/dokoro-core.js

# Tool allowlist for the local agent. Default exposes only ~9 council+memory tools so a
# small local model isn't drowned by ~70 tools. Override with a comma list, or
# TACHI_ALLOW="tachibot_,dokoro_" (prefixes) to expose everything.
# TACHI_ALLOW=tachibot_jury,tachibot_grok_search,dokoro_session_recall,dokoro_session_log

# HTTP gateway (deploy as a service). REQUIRED to start the gateway:
GATEWAY_PORT=8787
# single-tenant:
GATEWAY_TOKEN=change-me
# OR multi-tenant (overrides GATEWAY_TOKEN): "tenant:token" pairs, comma-separated
# GATEWAY_TOKENS=alice:tokA,bob:tokB
